# Meido — environment configuration
# Copy to .env and edit. Web UI alone is enough to run; messaging channels are optional.
#
# Meta (optional):
#   MEIDO_CONFIG=/absolute/path/to/.env   # override default ./.env
#   MEIDO_WORKSPACE_DIR=/path/to/workspace # overrides WORKSPACE_DIR after load
#   MEIDO_SELF_REPO=/absolute/path/to/meido  # ban Cursor/agent git on this checkout (auto-detected when WORKSPACE_DIR is inside the crate)
#   MEIDO_BUILTIN_SKILLS=/absolute/path/to/builtin_skills  # override shipped skills catalog
#   MEIDO_BUILTIN_HOOKS=/absolute/path/to/builtin_hooks    # override shipped hooks catalog
# Legacy FINALLY_A_VALUE_BOT_* names for the same keys still work as aliases.

# -----------------------------------------------------------------------------
# Channels — configure in Web UI → Settings → Integrations (SQLite)
# -----------------------------------------------------------------------------
# Tokens and per-instance settings live in the app database after first boot.
# First boot may one-time-import legacy values from the env names below if present;
# afterward the Web UI is authoritative — remove channel secrets from .env once
# Integrations looks correct. CONTROL_CHAT_IDS is global shared access.
#
# Optional Telegram first-boot import:
# TELEGRAM_BOT_TOKEN=
# BOT_USERNAME=
# ALLOWED_GROUPS=          # comma-separated Telegram chat ids
#
# Optional Discord first-boot import:
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_CHANNELS=
#
# Optional WhatsApp Cloud API first-boot import:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_WEBHOOK_PORT=8080
#
# Optional WeCom first-boot import:
# Preferred: 智能机器人 long connection (no public callback):
# WECOM_MODE=aibot
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_ALLOWED_CHATS=
# Self-built app callback (legacy):
# WECOM_CORP_ID=
# WECOM_SECRET=
# WECOM_AGENT_ID=
# WECOM_CALLBACK_TOKEN=
# WECOM_ENCODING_AES_KEY=
# WECOM_WEBHOOK_PORT=8081
# WECOM_ALLOWED_CHATS=
#
# CONTROL_CHAT_IDS=        # comma-separated canonical chat ids with operator access
#
# Headless (WEB_ENABLED=false): configure channels in the UI at least once with
# web enabled, or ensure channel_bot_instances / app_settings were migrated.

AGENT_DISPLAY_NAME=

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# API keys stay in .env; provider + model are chosen in Web UI → Settings → LLM (app DB).
# LLM_API_KEY=             # optional legacy; prefer provider-specific keys below
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # also used for Whisper voice transcription when set
# XAI_API_KEY=
# GEMINI_API_KEY=          # or GOOGLE_API_KEY (Gemini ADK engine + Gemini provider)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=            # optional custom API base (advanced)
#
# Optional bootstrap only — prefer Web UI → Settings → Agent engine after first start:
# AGENT_ENGINE=classic     # classic | classic_cost_routing | cursor | gemini_adk

# Limits (defaults shown)
MAX_TOKENS=8192
MAX_TOOL_ITERATIONS=100
MAX_HISTORY_MESSAGES=50
# RECENT_HISTORY_MIN_USER_MESSAGES=2       # min user text messages in balanced tail (1–25; 0 = default)
# RECENT_HISTORY_MIN_ASSISTANT_MESSAGES=2 # min assistant text messages in balanced tail (1–25; 0 = default)
MAX_DOCUMENT_SIZE_MB=100

# SHOW_THINKING=false        # surface model thinking blocks when supported

# -----------------------------------------------------------------------------
# Workspace and access control
# -----------------------------------------------------------------------------

WORKSPACE_DIR=./workspace
TIMEZONE=UTC

# UNIVERSAL_CHAT_ID=         # optional; several subsystems default to 997894126 when unset

# -----------------------------------------------------------------------------
# Web UI (default: enabled on localhost) — bootstrap; keep in .env
# -----------------------------------------------------------------------------

WEB_ENABLED=true
WEB_HOST=127.0.0.1
# A DNS name such as pp.local is the URL you open. The process listens on 0.0.0.0
# so that name can reach this machine, and WEB_AUTH_TOKEN is required.
# Meido does not register the name. Point it at this machine's LAN IP:
#   mDNS (.local matching the computer hostname): Linux avahi-daemon,
#     macOS `scutil --set LocalHostName`, or rename the Windows PC.
#     Extra name: avahi-publish -a -R pp.local <LAN-IP>
#   hosts file on each device: <LAN-IP>  pp.local
#     Linux/macOS /etc/hosts
#     Windows C:\Windows\System32\drivers\etc\hosts
#   Router or Pi-hole: an A record to that IP. Prefer .lan; many routers
#     will not answer names that end in .local.
# WEB_HOST=pp.local
WEB_PORT=10961
# WEB_AUTH_TOKEN=            # required when WEB_HOST is not local (127.0.0.1 / localhost / ::1)
WEB_MAX_INFLIGHT_PER_SESSION=2
WEB_MAX_REQUESTS_PER_WINDOW=8
WEB_RATE_WINDOW_SECONDS=10
WEB_RUN_HISTORY_LIMIT=512
WEB_SESSION_IDLE_TTL_SECONDS=300
# WEB_TERMINAL_ENABLED=false          # interactive PTY in web UI; always requires WEB_AUTH_TOKEN
# WEB_TERMINAL_MAX_SESSIONS=2
# WEB_TERMINAL_IDLE_TIMEOUT_SECS=1800
# WEB_TERMINAL_ALLOW_IN_DOCKER=false

# -----------------------------------------------------------------------------
# Scheduler (cron / one-shot tasks)
# -----------------------------------------------------------------------------

SCHEDULER_TASK_TIMEOUT_SECS=3600
SCHEDULER_STALE_RUNNING_RECLAIM_SECS=7200
SCHEDULER_MAX_CONCURRENT_TASKS=2
SCHEDULER_POLL_INTERVAL_SECS=60

# Agent background jobs (web handoff / long reruns) — lease must outlive long tool calls (e.g. ComfyUI)
# BACKGROUND_JOB_LEASE_TTL_SECS=1800
# BACKGROUND_JOB_LEASE_FALLBACK_RENEW_SECS=60
# BACKGROUND_JOB_PENDING_START_TIMEOUT_SECS=300
# BACKGROUND_JOB_NOTIFY_CHAT_PROGRESS=false  # interim chat notices while a background agent job runs

# Verbose PZ/ComfyUI script logging (WebSocket timeout / history poll lines). Default off.
# TOOL_OUTPUT_DEBUG=true

# Shell background jobs (spawn_background_command / tmux monitor)
BACKGROUND_SHELL_TMUX_ENABLED=true
BACKGROUND_SHELL_TMUX_SESSION_PREFIX=finally_a_value_bot-bg
BACKGROUND_SHELL_MONITOR_POLL_SECS=8
# BACKGROUND_SHELL_AUTO_RETRY_ON_FAILURE=true   # enqueue agent to fix + retry after shell failure
# BACKGROUND_SHELL_AUTO_RETRY_MAX=1
# BACKGROUND_SHELL_AUTO_AGENT_ON_SUCCESS=true   # enqueue agent to summarize after shell success

# -----------------------------------------------------------------------------
# Conversation topics (auto-segment outline + focus view)
# -----------------------------------------------------------------------------

# TOPICS_ENABLED=true
# TOPICS_MIN_UNSEGMENTED=6
# TOPICS_IDLE_MINUTES=20
# TOPICS_GAP_HOURS=6
# TOPICS_PREFER_TIER2=true
# TOPICS_DEBOUNCE_MINUTES=2
# Topic title provider/model: Web UI → Settings → Topics (app DB), not .env.

# -----------------------------------------------------------------------------
# Agent stack (evaluators, edit tools, hooks)
# -----------------------------------------------------------------------------

POST_TOOL_EVALUATOR_ENABLED=false
# POST_TOOL_EVALUATOR_MODEL=        # legacy alias → EVALUATOR_MODEL when set

# Post-delivery quality evaluation (async, after first reply is sent)
RESPONSE_QUALITY_EVALUATOR_ENABLED=false
# RESPONSE_QUALITY_EVALUATOR_MODEL= # optional override; empty uses EVALUATOR_MODEL
# Perplexity sidecar for PTE + PDQE fallback when local multimodel is unset (never uses LLM_API_KEY)
# PERPLEXITY_API_KEY=
# EVALUATOR_MODEL=sonar
# EVALUATOR_BASE_URL=https://api.perplexity.ai
# QUALITY_EVAL_MAX_NUDGES_PER_RUN=1
# QUALITY_EVAL_MIN_CONFIDENCE=0.85
# QUALITY_EVAL_CHANNELS=*

# Edit-tool framework (Classic / cost-routing engines)
# ALLOW_FUZZY_SEARCH_REPLACE=false
# SYMBOL_EDIT_ENABLED=false
# POST_EDIT_VALIDATION_ENABLED=true
# POST_EDIT_VALIDATION_COMMANDS=   # optional ;;-separated shell checks after edits

# Hook runtime (DB hook_definitions; six shipped hooks seed on first boot)
# HOOK_COMMAND_TIMEOUT_SECS=10
# HOOK_PROMPT_TIMEOUT_SECS=15
# HOOK_PROMPT_MODEL=

# Dense delivery (persona toggle + PreDelivery spill).
# Uploads the PDF to a public HTTPS host chain: catbox → litterbox → tmpfiles → pixeldrain.
# Browser User-Agent is required (catbox/Cloudflare 403s reqwest's default UA).
# Do not set none if the user-facing reply should include an external PDF link.
# Optional CATBOX_USERHASH for authenticated catbox uploads (never log the value).
# DELIVERY_UPLOAD_PROVIDER=catbox
# CATBOX_USERHASH=

# Prompt shaping (optional)
# MEMORY_PROMPT_MODE=json          # json | markdown | both
# MEMORY_PROMPT_INCLUDE_LEGEND=    # default true when mode=both
# WORKFLOW_PRINCIPLES_PROMPT_MAX=25
# SKILLS_CATALOG_MODE=compact      # compact | full

# -----------------------------------------------------------------------------
# Runtime reliability
# -----------------------------------------------------------------------------

RUNTIME_RELIABILITY_PROFILE=balanced
# balanced | aggressive_completion | safe_conservative

PROJECT_AUTO_ASSOCIATION_STRICTNESS=balanced
# strict | balanced | loose

# -----------------------------------------------------------------------------
# Cursor agent CLI (optional)
# -----------------------------------------------------------------------------

# CURSOR_AGENT_CLI_PATH=cursor-agent   # or cursor-agent.cmd on Windows if not on PATH
# CURSOR_AGENT_MODEL=
CURSOR_AGENT_TIMEOUT_SECS=3600
CURSOR_AGENT_TMUX_SESSION_PREFIX=meido-cursor
CURSOR_AGENT_TMUX_ENABLED=true
# CURSOR_AGENT_RUNNER_URL=   # e.g. http://host:3847 — remote runner for cursor-agent

# Cursor SDK engine (sidecar auto-starts with the bot on native installs)
# CURSOR_API_KEY=              # required for Cursor engine — Cursor Dashboard → Integrations
# CURSOR_SDK_MODEL=composer-2.5
# CURSOR_SDK_AUTO_START=true   # default: spawn scripts/cursor-sdk-runner.py on bot start
# CURSOR_SDK_AUTO_INSTALL=true # default: pip install cursor-sdk + aiohttp into runtime venv
# CURSOR_SDK_RUNNER_PORT=3848
# CURSOR_SDK_PYTHON=python3
# CURSOR_SDK_NODE=node         # Node for scripts/cursor-sdk-runner.mjs (default path)
# CURSOR_SDK_RUNNER_SCRIPT=    # override; default scripts/cursor-sdk-runner.mjs (set .py for Python rollback)
# CURSOR_SDK_RUNNER_URL=       # override only for remote sidecar; local default is http://127.0.0.1:3848
# CURSOR_BRIDGE_IDLE_TTL_SECS=600   # warm main/focus bridge idle TTL (default 600)
# CURSOR_BRIDGE_POOL_MAX=16         # max warm bridges in sidecar pool (default 16)
# CURSOR_BRIDGE_ORPHAN_GRACE_SECS=120  # age before killing untracked bridge PIDs
# CURSOR_BRIDGE_LAUNCH_TIMEOUT_SECS=60
# CURSOR_RUN_CONCURRENCY=4      # max concurrent /run agent turns in the sidecar (default 4)
# CURSOR_MAX_RUN_WALL_SECS=1200 # cancel only /run sessions older than this; keep younger ones
# CURSOR_SIDECAR_MAX_UPTIME_SECS=86400  # soft self-recycle when idle (default 24h); supervisor also enforces
# CURSOR_RUN_WAIT_TIMEOUT_MS=120000  # hang watchdog for run.wait() AFTER the stream ends (not the agent-turn budget)
# # reload.sh soft-drains then force-recycles the sidecar before gateway restart
# Needs Node.js + npm on PATH for the default sidecar. Bot auto-installs deps into
# {WORKSPACE_DIR}/runtime/cursor-sdk-venv (Python rollback) when CURSOR_SDK_AUTO_INSTALL=true.

# -----------------------------------------------------------------------------
# Steel browser (human-in-the-loop automation via steel-browser skill)
# -----------------------------------------------------------------------------

# BROWSER_MANAGED=false         # when true, bot auto-starts Steel Docker on boot (native installs; needs Docker)
# STEEL_API_PORT=13920          # host port mapped to Steel API (container 3000)
# STEEL_CDP_PORT=13923          # host port mapped to Steel CDP/debug (container 9223)
# STEEL_API_URL=http://127.0.0.1:13920
# STEEL_API_KEY=              # required for Steel Cloud; optional for self-hosted
# STEEL_DOCKER_IMAGE=ghcr.io/steel-dev/steel-browser:latest
# STEEL_DOCKER_CONTAINER_NAME=meido-steel
BROWSER_MANAGED=false
# BROWSER_EXECUTABLE_PATH=
BROWSER_CDP_PORT_BASE=9222
# BROWSER_IDLE_TIMEOUT_SECS=
BROWSER_HEADLESS=false

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------

SAFETY_OUTPUT_GUARD_MODE=moderate
# off | moderate | strict

SAFETY_MAX_EMOJIS_PER_RESPONSE=12
SAFETY_TAIL_REPEAT_LIMIT=8
SAFETY_EXECUTION_MODE=warn_confirm
# off | warn_confirm | strict

SAFETY_RISKY_CATEGORIES=destructive,system,network,package
# ENV_REDACT_MIN_VALUE_LEN=8   # min secret length when scrubbing env values from logs/tool output (4–128)

# -----------------------------------------------------------------------------
# Web search
# -----------------------------------------------------------------------------

# Prefer Tavily when set (builtin skill tavily-full / web_search tool).
# TAVILY_API_KEY=
# SEARXNG_URL=https://search.example.org
# Order: Tavily → SearXNG → DuckDuckGo HTML fallback.

# -----------------------------------------------------------------------------
# Voice (optional — OpenAI Whisper transcription on Telegram/WhatsApp/etc.)
# -----------------------------------------------------------------------------

# OPENAI_API_KEY=              # same key as LLM OpenAI; listed again under Voice for discoverability

# -----------------------------------------------------------------------------
# ORIGIN vault / vector search (optional) — uncomment and set to enable vault config
# Built-in skills (search-vault, index-vault) use scripts that read .env next to the script
# (e.g. workspace/skills/search-vault/.env). Set VAULT_EMBEDDING_SERVER_URL there (no default),
# or export it in the environment before running scripts.
# -----------------------------------------------------------------------------

# Relative to WORKSPACE_DIR, not the process working directory. A value of
# shared/vault_db is {WORKSPACE_DIR}/shared/vault_db (./workspace/shared/vault_db
# when WORKSPACE_DIR is ./workspace). Absolute paths are used unchanged.
# VAULT_ORIGIN_VAULT_PATH=shared/ORIGIN
# VAULT_VECTOR_DB_PATH=shared/vault_db
# VAULT_ORIGIN_VAULT_REPO=
# VAULT_GIT_URL=             # alias for VAULT_ORIGIN_VAULT_REPO
# VAULT_EMBEDDING_SERVER_URL=
# VAULT_SEARCH_COMMAND=
# VAULT_INDEX_COMMAND=
# VAULT_PRINCIPLES_PATH=AGENTS.md
# A missing principles file is filled from defaults/AGENTS.md on install and on first start.
# An existing file is left as-is.
# VAULT_VECTOR_DB_URL=
# VAULT_VECTOR_DB_COLLECTION=vault

# Paths outside the workspace, per persona. Unset means that persona cannot read or
# write absolute paths beyond the workspace and the vault paths above. The Persona
# page writes this key. The value is a JSON array of absolute paths.
# MEIDO_PERSONA_2_EXTERNAL_PATHS=["/absolute/path"]

# -----------------------------------------------------------------------------
# MemPalace recall
# -----------------------------------------------------------------------------
# default (the install default) serves MemPalace and pauses the built-in ORIGIN
# index job. shadow compares MemPalace off the reply. selected limits it to
# MEMPALACE_SELECTED_PERSONA_IDS. disabled keeps history search and the ORIGIN
# vector index. When command and endpoint are empty, gateway install and bot
# startup install the official MCP (`python -m mempalace.mcp_server`) into
# {WORKSPACE_DIR}/runtime/mempalace-venv and keep the palace data in
# {WORKSPACE_DIR}/runtime/mempalace.
# MEMPALACE_RECALL_MODE=default
# MEMPALACE_LIGHT_MCP_COMMAND=
# MEMPALACE_LIGHT_MCP_ARGS=
# MEMPALACE_LIGHT_MCP_ENDPOINT=
# MEMPALACE_STARTUP_TIMEOUT_SECS=180
# MEMPALACE_QUERY_TIMEOUT_SECS=60
# MEMPALACE_SELECTED_PERSONA_IDS=

# -----------------------------------------------------------------------------
# Social integrations (optional) — uncomment any block you use
# -----------------------------------------------------------------------------

# SOCIAL_BASE_URL=
# SOCIAL_TIKTOK_CLIENT_ID=
# SOCIAL_TIKTOK_CLIENT_SECRET=
# SOCIAL_INSTAGRAM_CLIENT_ID=
# SOCIAL_INSTAGRAM_CLIENT_SECRET=
# SOCIAL_LINKEDIN_CLIENT_ID=
# SOCIAL_LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Git credentials (optional) — not read into Config; used by scripts/tooling (e.g. HTTPS git push)
# -----------------------------------------------------------------------------

# GIT_USERNAME=
# GIT_TOKEN=
