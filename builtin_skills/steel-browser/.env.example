STEEL_API_URL=http://127.0.0.1:13920
STEEL_API_KEY=
STEEL_SESSION_TIMEOUT_MS=3600000
STEEL_USE_PROXY=false
STEEL_SOLVE_CAPTCHA=false

# Self-hosted Docker: persist Chrome profile across sessions/restarts (requires profile volume mount)
STEEL_PERSIST=true

# Steel Cloud only: named profile id returned after first persist_profile session
# STEEL_PROFILE_ID=
# STEEL_PERSIST_PROFILE=false

# Optional self-hosted override (path inside the Steel container)
# STEEL_USER_DATA_DIR=/app/api/user-data-dir
